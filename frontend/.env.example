# Copy this file to .env.local for local development
# For Netlify: add VITE_API_URL in Netlify → Site Settings → Environment Variables

# Local dev (backend running on your machine)
VITE_API_URL=http://127.0.0.1:8000

# Production (your Render backend URL — fill this in after deploying backend)
# VITE_API_URL=https://your-app-name.onrender.com
